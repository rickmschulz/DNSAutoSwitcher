<?xml version="1.0" encoding="utf-8"?>
<!--
   The settings are excluded on purpose: a restore onto a new phone would otherwise come back with
   the old SSID, the old provider - and an "enabled" flag that starts a foreground service on a
   device where the ADB permission was never granted.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="DNSAutoSwitcherPrefs.xml" />
</full-backup-content>
