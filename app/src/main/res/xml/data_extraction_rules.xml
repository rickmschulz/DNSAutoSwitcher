<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the preferences are deliberately not transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="DNSAutoSwitcherPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="DNSAutoSwitcherPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
